  "fixed_sql": [
    {
      "name": "recurring_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_rules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL CHECK(LENGTH(TRIM(\"name\")) BETWEEN 1 AND 80), \"cadence\" TEXT NOT NULL, \"anchor_date\" TEXT NOT NULL, \"next_index\" INTEGER NOT NULL DEFAULT 0, \"bonus\" TEXT NOT NULL, \"last_posted_on\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "missions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"missions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL CHECK(LENGTH(TRIM(\"name\")) BETWEEN 1 AND 80), \"bonus\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'open', \"created_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"awarded_bonus\" INTEGER NULL, \"rule_id\" INTEGER NULL REFERENCES recurring_rules (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "quests",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quests\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL CHECK(LENGTH(TRIM(\"name\")) BETWEEN 1 AND 80), \"note\" TEXT NULL CHECK(LENGTH(\"note\") <= 500), \"difficulty\" TEXT NOT NULL, \"mission_id\" INTEGER NULL REFERENCES missions (id) ON DELETE CASCADE, \"board\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"awarded_xp\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "rule_quests",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rule_quests\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"rule_id\" INTEGER NOT NULL REFERENCES recurring_rules (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state\" (\"id\" INTEGER NOT NULL DEFAULT 1 CHECK(\"id\" = 1), \"total_xp\" INTEGER NOT NULL DEFAULT 0 CHECK(\"total_xp\" >= 0), \"hero_name\" TEXT NOT NULL DEFAULT '', \"language\" TEXT NOT NULL DEFAULT 'system', \"theme\" TEXT NOT NULL DEFAULT 'system', \"display_font\" TEXT NOT NULL DEFAULT 'figtree', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "idx_quests_mission",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_quests_mission ON quests (mission_id)"
        }
      ]
    },
    {
      "name": "idx_quests_completed",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_quests_completed ON quests (completed_at)"
        }
      ]
    }
  ]
